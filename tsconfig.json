{
  "compilerOptions": {
    "outDir": "./dist/",
    "module": "commonjs",
    "target": "es2015",
    "jsx": "react",
    "allowJs": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"],
      "api": ["./api"],
      "api/*": ["./api/*"]
    }
  },
  "exclude": ["node_modules", "dist", "publish", "tests", "vitest.config.ts"]
}
